// Swapify data model
//
// Conventions:
// - All money amounts are stored as integer GBP pence (1 pound = 100 pence).
//   This avoids floating-point errors, the same way Stripe stores money in
//   its minor units.
// - Model names use PascalCase; fields use camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & identity
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  SUPPORT
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  bio             String?
  imageUrl        String?
  // Subject ID from AWS Cognito once authentication is wired up (Sprint 1).
  cognitoSub      String?        @unique
  items           Item[]
  wishlists       Wishlist[]
  admin           Admin?
  swapsOffered    Swap[]         @relation("OfferingUser")
  swapsRequested  Swap[]         @relation("RequestedUser")
  paymentsMade    Payment[]      @relation("PayerUser")
  messagesSent    Message[]      @relation("MessageSender")
  ratingsGiven    Rating[]       @relation("Rater")
  ratingsReceived Rating[]       @relation("Ratee")
  notifications   Notification[]
  addresses       UserAddress[]
  shipmentsSent   Shipment[]     @relation("ShipmentSender")
  shipmentsReceived Shipment[]   @relation("ShipmentReceiver")
  shippingPaymentsMade ShippingPayment[] @relation("ShippingPayer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Admin {
  id     String    @id @default(cuid())
  userId String    @unique
  role   AdminRole @default(SUPPORT)
  user   User      @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

enum Category {
  ELECTRONICS
  FURNITURE
  CLOTHING
  BOOKS
  GAMES
  TOOLS
  SPORTS
  HOME_KITCHEN
  COLLECTIBLES
  OTHER
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ItemStatus {
  ACTIVE
  RESERVED // currently involved in an in-progress swap
  SWAPPED
  HIDDEN
  DELETED
}

model Item {
  id               String      @id @default(cuid())
  ownerId          String
  owner            User        @relation(fields: [ownerId], references: [id])
  title            String
  description      String
  category         Category
  condition        Condition
  // Owner-set value in GBP pence (5000 = £50.00). Manual for now; an AI
  // valuation service will plug in later without changing this model.
  valuePence       Int
  status           ItemStatus  @default(ACTIVE)
  images           ItemImage[]
  offeredInSwaps   Swap[]      @relation("OfferedItem")
  requestedInSwaps Swap[]      @relation("RequestedItem")
  shipments        Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([category, status])
  @@index([status])
}

model ItemImage {
  id       String @id @default(cuid())
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // Object key in S3 once the image pipeline is live (Sprint 8).
  url      String
  position Int    @default(0)

  @@unique([itemId, position])
}

// ---------------------------------------------------------------------------
// Swaps, payments & value balancing
// ---------------------------------------------------------------------------

enum SwapStatus {
  REQUESTED
  AGREED
  PAID // the value-gap payment has been received
  SHIPPED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum GapPayer {
  OFFERING_USER // the person offering an item pays the value gap
  REQUESTING_USER // the person requesting the swap pays the value gap
  NONE // values are equal, no gap
}

model Swap {
  id              String     @id @default(cuid())
  offeringUserId  String
  offeringItemId  String
  offeringItem    Item       @relation("OfferedItem", fields: [offeringItemId], references: [id])
  offeringUser    User       @relation("OfferingUser", fields: [offeringUserId], references: [id])
  requestedUserId String
  requestedItemId String
  requestedItem   Item       @relation("RequestedItem", fields: [requestedItemId], references: [id])
  requestedUser   User       @relation("RequestedUser", fields: [requestedUserId], references: [id])
  // Value difference in GBP pence (absolute value).
  gapPence        Int        @default(0)
  gapPayer        GapPayer   @default(NONE)
  status          SwapStatus @default(REQUESTED)
  payment         Payment?

  // Each party confirms they received the other item; swap completes when both have.
  offeringUserConfirmedAt  DateTime?
  requestedUserConfirmedAt DateTime?

  messages   Message[]
  ratings    Rating[]
  shipments  Shipment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?
  expiresAt   DateTime?

  @@index([offeringUserId])
  @@index([requestedUserId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Payments (Stripe)
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

/// The single Stripe payment that settles a swap's value gap plus the Swapify
/// service fee, collected from the party who owes the gap. stripeCheckoutSessionId
/// is unique so the Stripe webhook can never mark the same payment twice.
model Payment {
  id                      String        @id @default(cuid())
  swapId                  String        @unique
  swap                    Swap          @relation(fields: [swapId], references: [id])
  payerUserId             String
  payerUser               User          @relation("PayerUser", fields: [payerUserId], references: [id])
  // Value difference the payer owes, in GBP pence.
  amountPence             Int
  // Swapify service fee (5% of the higher-value item), in GBP pence.
  feePence                Int
  // amountPence + feePence, in GBP pence. Matches the Stripe charge.
  totalPence              Int
  status                  PaymentStatus @default(PENDING)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?
  // Set once the gap payment has been refunded (swap cancelled/expired after
  // payment). Makes refunds a durable no-op and guarantees a payment can never
  // be refunded twice, even if a refund is issued concurrently by two API
  // instances or retried after a crash.
  stripeRefundId          String?
  refundedAt              DateTime?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([payerUserId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Messaging, ratings, wishlists, notifications
// ---------------------------------------------------------------------------

model Message {
  id       String @id @default(cuid())
  swapId   String
  swap     Swap   @relation(fields: [swapId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])
  body     String

  createdAt DateTime @default(now())

  @@index([swapId, createdAt])
}

model Rating {
  id      String  @id @default(cuid())
  swapId  String
  swap    Swap    @relation(fields: [swapId], references: [id], onDelete: Cascade)
  raterId String
  rater   User    @relation("Rater", fields: [raterId], references: [id])
  rateeId String
  ratee   User    @relation("Ratee", fields: [rateeId], references: [id])
  // 1-5 stars
  score   Int
  comment String?

  createdAt DateTime @default(now())

  @@unique([swapId, raterId])
  @@index([rateeId])
}

model Wishlist {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  title         String
  description   String?
  // Optional category hint used when matching against active listings.
  category      Category?
  // Optional ceiling for what the user is willing to spend on the gap, in GBP pence.
  maxValuePence Int?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum NotificationType {
  SWAP_REQUEST
  SWAP_UPDATE
  MESSAGE
  RATING
  ESCROW
  SYSTEM
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        NotificationType
  body        String
  read        Boolean          @default(false)
  // Optional deep-link target (e.g. swap id).
  referenceId String?

  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ---------------------------------------------------------------------------
// Shipping (post-trade delivery lifecycle)
// ---------------------------------------------------------------------------

enum ShipmentStatus {
  PENDING       // shipment created, postage not yet paid
  LABEL_READY   // postage paid, label available
  IN_TRANSIT    // carrier has the parcel
  DELIVERED     // carrier confirms delivery
  CANCELLED     // label voided / postage refunded / swap cancelled
}

model UserAddress {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  line1     String
  line2     String?
  city      String
  postcode  String
  country   String  @default("GB")
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Shipment {
  id              String          @id @default(cuid())
  swapId          String
  swap            Swap            @relation(fields: [swapId], references: [id], onDelete: Cascade)
  senderUserId    String
  sender          User            @relation("ShipmentSender", fields: [senderUserId], references: [id])
  receiverUserId  String
  receiver        User            @relation("ShipmentReceiver", fields: [receiverUserId], references: [id])
  itemId          String
  item            Item            @relation(fields: [itemId], references: [id])
  status          ShipmentStatus  @default(PENDING)

  // Delivery address snapshot (immutable historical copy)
  addressLine1    String?
  addressLine2    String?
  addressCity     String?
  addressPostcode String?
  addressCountry  String?

  // Label / provider data
  carrier               String?
  service               String?
  providerShipmentId    String?
  providerLabelId       String?
  trackingNumber        String?
  trackingUrl           String?
  labelUrl              String?
  qrCodeUrl             String?

  // Postage cost (GBP pence, integer)
  postagePence          Int?

  // Deadlines
  postageDeadline       DateTime?
  shipDeadline          DateTime?

  // Timestamps
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?

  payment               ShippingPayment?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // One shipment per sender per swap
  @@unique([swapId, senderUserId])
  @@index([senderUserId])
  @@index([receiverUserId])
  @@index([status])
  @@index([swapId])
  @@index([itemId])
}

model ShippingPayment {
  id                        String        @id @default(cuid())
  shipmentId                String        @unique
  shipment                  Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  payerUserId               String
  payerUser                 User          @relation("ShippingPayer", fields: [payerUserId], references: [id])
  amountPence               Int
  status                    PaymentStatus @default(PENDING)
  stripeCheckoutSessionId   String?       @unique
  stripePaymentIntentId     String?
  stripeRefundId            String?
  refundedAt                DateTime?

  createdAt                 DateTime      @default(now())
  paidAt                    DateTime?

  @@index([payerUserId, createdAt(sort: Desc)])
}
