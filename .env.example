# ---------------------------------------------------------------------------
# Swapify environment variables
# Copy this file to a real `.env` (one per package that needs it) and fill in.
# NEVER commit real secrets. Local secrets live in `.env` (git-ignored).
# ---------------------------------------------------------------------------

# --- Database (local Docker Postgres, see infra/docker-compose.yml) ---
# Used by packages/db (Prisma reads it from packages/db/.env).
DATABASE_URL="postgresql://swapify:swapify@localhost:5432/swapify?schema=public"

# --- API ---
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- AWS (Cognito auth, provisioned via infra/cloudformation/cognito.yml) ---
# Values are also stored in AWS Secrets Manager under the secret: swapify/cognito
AWS_REGION=us-east-1
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=replace-me
COGNITO_CLIENT_ID=replace-me

# --- Web app (apps/web/.env.local) ---
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=openssl rand -base64 32
# COGNITO_CLIENT_SECRET=from Secrets Manager: swapify/cognito
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# API_URL=http://localhost:4000
# NEXT_PUBLIC_IMAGE_BASE_URL=https://<cloudfront-distribution>.cloudfront.net
#   (production only; resolves relative image keys to the CDN. Unset in dev,
#   where the API origin serves uploaded images.)

# --- Image storage (S3 + CloudFront; see infra/cloudformation/storage.yml) ---
# STORAGE_DRIVER=local | s3   (default local; S3 only for production)
# S3_BUCKET=swapify-images-prod
# S3_PREFIX=uploads
# CDN_BASE_URL=https://<cloudfront-distribution>.cloudfront.net
# AWS_REGION=us-east-1
# AWS credentials come from the API task role / instance profile (no static keys).

# --- Stripe (Sprint 6: buying tokens) ---
# Production is fail-closed: with NODE_ENV=production, missing STRIPE_SECRET_KEY
# or STRIPE_WEBHOOK_SECRET refuses startup, and checkout is never simulated.
# Outside production, leaving STRIPE_SECRET_KEY unset enables a local simulated
# checkout that credits the wallet directly (see /stripe/dev-confirm).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# WEB_BASE_URL=http://localhost:3000
