# ---------------------------------------------------------------------------
# Swapify environment variables
# Copy this file to a real `.env` (one per package that needs it) and fill in.
# NEVER commit real secrets. Local secrets live in `.env` (git-ignored).
# ---------------------------------------------------------------------------

# --- Database (local Docker Postgres, see infra/docker-compose.yml) ---
# Used by packages/db (Prisma reads it from packages/db/.env).
DATABASE_URL="postgresql://swapify:swapify@localhost:5432/swapify?schema=public"

# --- API ---
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- AWS (added in Sprint 1 for Cognito auth) ---
# AWS_REGION=eu-west-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# --- Stripe (added in Sprint 6 for buying tokens) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
